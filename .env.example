# All settings are optional. Never commit real secrets.
MARKETSENTINEL_DATABASE_PATH=data/marketsentinel.db
MARKETSENTINEL_API_BASE_URL=http://127.0.0.1:8000
MARKETSENTINEL_FINBERT_MODEL=ProsusAI/finbert
MARKETSENTINEL_FINBERT_DEVICE=auto
MARKETSENTINEL_FINBERT_BATCH_SIZE=8
MARKETSENTINEL_NEWS_LOOKBACK_DAYS=7
MARKETSENTINEL_NEWS_MAX_ARTICLES=50
MARKETSENTINEL_HISTORICAL_NEWS_DAYS=30
MARKETSENTINEL_HISTORICAL_NEWS_MAX_ARTICLES=180
MARKETSENTINEL_HISTORICAL_GDELT_WINDOW_DAYS=30
# GDELT currently asks public users to limit requests to one every five seconds.
MARKETSENTINEL_HISTORICAL_GDELT_REQUEST_INTERVAL_SECONDS=5.25
MARKETSENTINEL_ALLOW_DEMO_FALLBACK=true

# Optional. ProsusAI/finbert is public and does not require this token.
# MARKETSENTINEL_HF_TOKEN=

# Optional on-demand article event analysis. Leave the key unset to disable this feature safely.
# MARKETSENTINEL_LLM_API_KEY=
# MARKETSENTINEL_LLM_MODEL=gpt-4o-mini
# MARKETSENTINEL_LLM_BASE_URL=https://api.openai.com/v1
# MARKETSENTINEL_LLM_TIMEOUT_SECONDS=30
