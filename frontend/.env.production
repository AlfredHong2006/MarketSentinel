# Production build config for the single-service deployment, where FastAPI serves this client
# and the API from one origin.
#
# Deliberately empty. The client reads `import.meta.env.VITE_API_BASE_URL ?? "http://127.0.0.1:8000"`,
# and an empty string is not nullish, so it survives the `??` and every request becomes a
# relative, same-origin one such as `/api/v1/capabilities`. That means no hardcoded deployment
# hostname to keep in sync, and no CORS involvement at all.
#
# `vite build` loads this automatically (production mode). The local dev server keeps using
# .env.example / .env, so `npm run dev` against a separate API on :8000 is unchanged.
VITE_API_BASE_URL=
